{
  "name": "vynk-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "VYNK — Find your people. Learn. Build. Rise. Student-first social & collaboration platform.",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "generate:bigdata": "node scripts/generate-bigdata.js",
    "db:generate": "pnpm --filter @vynk/database db:generate",
    "db:push": "pnpm --filter @vynk/database db:push",
    "db:seed": "pnpm --filter @vynk/database db:seed",
    "doctor": "node scripts/doctor.js",
    "vynk:doctor": "node scripts/doctor.js"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "bcryptjs"
    ]
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8"
  }
}
