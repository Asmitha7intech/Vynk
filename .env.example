# ==============================================================================
# VYNK PLATFORM ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env in local development or configure these variables in
# your cloud deployment platform (Railway, Render, Fly.io, Vercel, Docker, etc.).
# NEVER commit raw .env files with production secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# CORE SERVER CONFIGURATION
# ------------------------------------------------------------------------------
PORT=4000
NODE_ENV=production
API_URL=https://api.vynk.app
WEB_URL=https://vynk.app

# ------------------------------------------------------------------------------
# DATABASE & CACHE
# ------------------------------------------------------------------------------
# PostgreSQL Connection String (supports Neon, Supabase, AWS RDS, Docker)
# e.g., postgresql://vynk_admin:<STRONG_PASSWORD>@db.example.com:5432/vynk_db?sslmode=require
DATABASE_URL=postgresql://vynk_admin:CHANGE_ME_DATABASE_PASSWORD@localhost:5432/vynk_db?schema=public

# Redis Connection URL (used for session caching, pub/sub, rate limiting)
# e.g., redis://default:<REDIS_PASSWORD>@redis.example.com:6379
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# CRYPTOGRAPHY & AUTHENTICATION SECRETS (MANDATORY IN PRODUCTION)
# ------------------------------------------------------------------------------
# In production, JWT_SECRET and JWT_REFRESH_SECRET must be at least 32 random chars.
# Generate via: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_PRODUCTION_JWT_ACCESS_SECRET_32_CHARS_MIN
JWT_REFRESH_SECRET=CHANGE_ME_PRODUCTION_JWT_REFRESH_SECRET_32_CHARS_MIN
COOKIE_SECRET=CHANGE_ME_PRODUCTION_COOKIE_ENCRYPTION_KEY_32_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# CANONICAL OWNER / SUPER_ADMIN PROVISIONING
# ------------------------------------------------------------------------------
OWNER_EMAIL=asmitha7intech@gmail.com
OWNER_USERNAME=asmitha
OWNER_DISPLAY_NAME=Asmitha S
OWNER_INITIAL_PASSWORD=CHANGE_ME_INITIAL_STRONG_PASSWORD

# ------------------------------------------------------------------------------
# CORS & FRONTEND CLIENT
# ------------------------------------------------------------------------------
CORS_ORIGIN=https://vynk.app

# ------------------------------------------------------------------------------
# EMAIL SERVICE (ACADEMIC VERIFICATION & NOTIFICATIONS)
# ------------------------------------------------------------------------------
# Options: 'resend' or 'smtp'
EMAIL_FROM=VYNK Campus <noreply@vynk.app>
RESEND_API_KEY=re_CHANGE_ME_RESEND_KEY

# Alternative SMTP settings if not using Resend
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@vynk.app
SMTP_PASS=CHANGE_ME_SMTP_PASSWORD

# Optional list of comma-separated allowed academic domains (.edu, .ac.in, etc.)
# If left empty, any valid email can register but campus badge is restricted.
ALLOWED_COLLEGE_DOMAINS=citchennai.net,annauniv.edu,iitm.ac.in,mit.edu,stanford.edu

# ------------------------------------------------------------------------------
# OBJECT STORAGE (AVATARS, VOYAGE ATTACHMENTS, MEDIA)
# ------------------------------------------------------------------------------
# Options: 'local', 's3', 'r2'
STORAGE_PROVIDER=r2
STORAGE_BUCKET=vynk-assets
STORAGE_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY=CHANGE_ME_CLOUDFLARE_R2_ACCESS_KEY
STORAGE_SECRET_KEY=CHANGE_ME_CLOUDFLARE_R2_SECRET_KEY

# ------------------------------------------------------------------------------
# REAL-TIME & EVENT STREAMING (OPTIONAL / PRODUCTION SCALE)
# ------------------------------------------------------------------------------
KAFKA_BROKER=
KAFKA_CLIENT_ID=vynk-api

# ------------------------------------------------------------------------------
# LOGGING & MONITORING
# ------------------------------------------------------------------------------
LOG_LEVEL=info
SENTRY_DSN=
